{
  "name": "nuhan-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "db:push": "cd backend && npx prisma db push",
    "db:seed": "cd backend && node prisma/seed.js",
    "db:studio": "cd backend && npx prisma studio",
    "db:generate": "cd backend && npx prisma generate",
    "build": "npm install --prefix frontend && cd frontend && npm run build",
    "start": "node index.js",
    "postinstall": "prisma generate --schema backend/prisma/schema.prisma"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.4.5",
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "prisma": "^5.20.0"
  }
}
