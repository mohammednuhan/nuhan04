# Backend environment variables (copy this file to .env and fill in values)
# PostgreSQL connection string (required by Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/neondb?sslmode=require"

# Port the API server listens on (defaults to 5000)
PORT=5000

# Allowed frontend origin for CORS (defaults to http://localhost:5173)
FRONTEND_URL=http://localhost:5173
